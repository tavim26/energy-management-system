# Copy this file to .env and fill in the values. The .env file is ignored by git.

# Google Gemini API key for the AI chatbot: https://aistudio.google.com/app/apikey
# If empty, the chatbot answers only with its predefined rules.
GEMINI_API_KEY=

# First admin account, created on startup only if no admin exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
